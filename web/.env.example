OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# TTS model for generate_voiceover/generate_transcript/voice samples (default gpt-4o-mini-tts).
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Required to generate images: Google Imagen. Get a key at https://aistudio.google.com.
GEMINI_API_KEY=
# Optional: override the Imagen model (default imagen-4.0-fast-generate-001).
IMAGEN_MODEL=imagen-4.0-fast-generate-001

# Public site origin used for SEO (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://chat.cappuai.com

# Cost guardrails. Longest video the agent may target and the most images it may
# generate per video. The agent clamps to these before generating.
MAX_VIDEO_DURATION_SECONDS=30
MAX_IMAGES_PER_VIDEO=10

# Where job artifacts (audio/images/project files) are written (default <cwd>/.data/runs).
RUNS_DIR=

DATABASE_URL=

# Clerk authentication (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
