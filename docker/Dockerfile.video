# syntax=docker/dockerfile:1
# FastAPI connector (video/ :3333). Build context: ../video
#
# Only the light connector deps (requirements-api.txt) are installed — the API itself
# never imports the heavy model libs. FLUX images and Kokoro voiceover run from a separate
# .venv as a subprocess and are Apple-Silicon/MLX-specific: they will NOT run in this Linux
# container. The API, job store, write_script and build_video work. Image generation works
# via the Imagen backend (provider="imagen") when GEMINI_API_KEY is set — it is a pure
# cloud call with no ML deps. Voiceover/transcript and FLUX images fail with a clear error.
# See docker/README.md.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 VIDEO_JOBS_DB=/data/jobs.db

COPY requirements-api.txt ./
RUN pip install --upgrade pip && pip install -r requirements-api.txt

COPY . .
RUN mkdir -p /data /app/api/runs

EXPOSE 3333
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "3333"]
