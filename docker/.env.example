# Copy to .env (beside docker-compose.yml) or paste into Dokploy → Environment.

# Required: key for the OpenAI-compatible chat model the agent uses.
OPENAI_API_KEY=sk-...

# Optional: point at any OpenAI-compatible provider (e.g. https://api.deepseek.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model id (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Required: Neon Postgres URL shared by the web app (conversations/messages) and the
# video connector (job store). Use the pooled connection string.
DATABASE_URL=

# Optional: Google Imagen image backend for the video connector (works on Linux/Dokploy,
# unlike FLUX). Set this to generate images without the local model venv. Pick "Imagen 4
# Fast" in the web toolbar. Get a key at https://aistudio.google.com.
GEMINI_API_KEY=
# Optional: override the Imagen model (default imagen-4.0-fast-generate-001).
IMAGEN_MODEL=imagen-4.0-fast-generate-001

# Cost guardrails — hard caps shared by web (agent clamps) and video (API validation).
# Longest video the agent may target (seconds) and the most images per video.
MAX_VIDEO_DURATION_SECONDS=30
MAX_IMAGES_PER_VIDEO=10