# Copy to .env (beside docker-compose.yml) or paste into Dokploy → Environment.

# Required: key for the OpenAI-compatible chat model the agent uses (also powers TTS).
OPENAI_API_KEY=sk-...

# Optional: point at any OpenAI-compatible provider (e.g. https://api.deepseek.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: chat model id (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: TTS model id for narration (default gpt-4o-mini-tts).
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Required: Neon Postgres URL — conversations/messages and the async job store share it.
# Use the pooled connection string.
DATABASE_URL=

# Required to generate images: Google Imagen. Get a key at https://aistudio.google.com.
GEMINI_API_KEY=
# Optional: override the Imagen model (default imagen-4.0-fast-generate-001).
IMAGEN_MODEL=imagen-4.0-fast-generate-001

# Cost guardrails — longest video the agent may target (seconds) and the most images
# per video.
MAX_VIDEO_DURATION_SECONDS=30
MAX_IMAGES_PER_VIDEO=10
